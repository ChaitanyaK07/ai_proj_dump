# ---------------------------------------------------------------- data
# Published on purpose (do NOT ignore): data/labels/train_weights/, data/labels/heldout_weights/
# (label shards, ~3.5 MB each) and data/processed/graph.npz (2 MB, byte-identical on every rebuild).
#
# Never commit a single-file label set: it is ~140 MB, over GitHub's 100 MB per-file limit.
data/labels/labels_*.npz

# Raw rasters and the OSMnx download cache (scripts/acquisition/)
*.tif
*.tiff
cache/

# ---------------------------------------------------------------- run output
# console logs of long runs (the result files they produced are tracked)
*.log
# user-study answers are participant data: share results/user_study/summary.csv, not the raw file
results/user_study/responses.jsonl
# intermediate file of the report build (REPORT.md and the PDF are tracked)
docs/report/_build/

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# virtual environments
.venv/
venv/
env/
.conda/

# ---------------------------------------------------------------- editors and OS
.idea/
.vscode/
.claude/
*.swp
.DS_Store
Thumbs.db
desktop.ini
